# --- Configuracion de Conexion MQTT (No sensible) ---
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_TOPIC_FILTER=home/server-room/#

# --- Configuracion de Conexion InfluxDB 2.7 (No sensible) ---
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_ORG=homelab
INFLUXDB_BUCKET=server_room
INFLUXDB_RETENTION=90d
INFLUXDB_USERNAME=admin

# --- Rutas internas de Docker Secrets (En memoria RAM /run/secrets) ---
INFLUX_TOKEN_FILE=/run/secrets/influx_write_token
